{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "Smart Healthcare System - Payment Service",
  "main": "server.js",
  "scripts": {
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed-test-data.js"
  },
  "keywords": [
    "healthcare",
    "payment",
    "stripe"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.0.1",
    "joi": "^17.11.0",
    "mongoose": "^8.19.1",
    "stripe": "^14.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!server.js"
    ]
  }
}
